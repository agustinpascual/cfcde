# Credenciais PinPay — https://hub.usepinpay.com/documentacao
# Copie para .env.local e preencha. NUNCA versione .env.local.

# Chave secreta (sk_live_… / sk_test_…). Só o servidor lê. Sem prefixo NEXT_PUBLIC_.
PINPAY_TOKEN=

# Signing Secret do webhook (whsec_…), no painel → Webhooks.
# Cada endpoint cadastrado tem o seu.
PINPAY_WEBHOOK_SECRET=

# URL pública do site. CONGELA NO BUILD (prefixo NEXT_PUBLIC_): é o valor
# presente na hora do `next build` que vai para o bundle, não o do runtime.
# Base de canonical, Open Graph, sitemap, robots e do checkout_url da cobrança.
# Sem barra no fim.
NEXT_PUBLIC_SITE_URL=https://cafecomdeusepai.com

# ---------- Supabase ----------
# URL e chave anon são públicas por desenho (a RLS é quem protege).
NEXT_PUBLIC_SUPABASE_URL=https://hsepvodzygwaeizxbdmo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role IGNORA a RLS — só no servidor, jamais com prefixo NEXT_PUBLIC_.
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Painel administrativo (/painel) ----------
# Sem estas duas o painel fica bloqueado.
# Usuário único do /painel. Não existe tabela de usuários: é este par que
# autentica o admin. Senha longa e aleatória; trocar aqui derruba as sessões.
PAINEL_EMAIL=admin@seudominio.com.br
PAINEL_SENHA=

# ---------- Resend (e-mails transacionais) ----------
RESEND_API_KEY=
RESEND_REMETENTE="Bela Blue Beauty <pedidos@seudominio.com.br>"

# ---------- Z-API (WhatsApp) ----------
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# ---------- Cofre das integrações ----------
# Cifra (AES-256-GCM) os segredos guardados no banco. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CHAVE_MESTRA=

# Protege /api/cron/avisos-pix. Na Cloudflare quem chama é o Worker
# workers/avisos-pix (o worker do OpenNext não tem handler `scheduled`),
# e ele precisa do MESMO valor:
#   npx wrangler secret put CRON_SECRET --name cfcde-avisos-pix
CRON_SECRET=

# ---------- Anthropic (robô do WhatsApp) ----------
# Sem ela o robô fica desligado; o resto do site funciona normalmente.
ANTHROPIC_API_KEY=

# Trava anticópia: domínios onde a loja pode rodar (separados por vírgula).
# Vazio = trava desligada. Fora desta lista, o navegador é mandado para o Google.
NEXT_PUBLIC_DOMINIOS_OFICIAIS=
