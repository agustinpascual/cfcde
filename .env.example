# Credenciais PinPay — https://hub.usepinpay.com/documentacao
# Copie para .env.local e preencha. NUNCA versione .env.local.

# Chave secreta (sk_live_… / sk_test_…). Só o servidor lê. Sem prefixo NEXT_PUBLIC_.
PINPAY_TOKEN=

# Signing Secret do webhook (whsec_…), no painel → Webhooks.
# Cada endpoint cadastrado tem o seu.
PINPAY_WEBHOOK_SECRET=

# URL pública do site, usada no metadata.checkout_url da cobrança.
NEXT_PUBLIC_SITE_URL=https://bella-gummy.vercel.app
