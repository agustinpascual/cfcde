# Credenciais PinPay — https://hub.usepinpay.com/documentacao
# Copie para .env.local e preencha. NUNCA versione .env.local.

# Chave secreta (sk_live_… / sk_test_…). Só o servidor lê. Sem prefixo NEXT_PUBLIC_.
PINPAY_TOKEN=

# Signing Secret do webhook (whsec_…), no painel → Webhooks.
# Cada endpoint cadastrado tem o seu.
PINPAY_WEBHOOK_SECRET=

# URL pública do site, usada no metadata.checkout_url da cobrança.
NEXT_PUBLIC_SITE_URL=https://bella-gummy.vercel.app

# ---------- Supabase ----------
# URL e chave anon são públicas por desenho (a RLS é quem protege).
NEXT_PUBLIC_SUPABASE_URL=https://hsepvodzygwaeizxbdmo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role IGNORA a RLS — só no servidor, jamais com prefixo NEXT_PUBLIC_.
# Supabase → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Painel administrativo (/painel) ----------
# Sem estas duas o painel fica bloqueado.
PAINEL_EMAIL=
PAINEL_SENHA=

# ---------- Resend (e-mails transacionais) ----------
RESEND_API_KEY=
RESEND_REMETENTE="Bela Blue Beauty <pedidos@seudominio.com.br>"

# ---------- Z-API (WhatsApp) ----------
ZAPI_INSTANCIA=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# ---------- Cofre das integrações ----------
# Cifra (AES-256-GCM) os segredos guardados no banco. Mínimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
CHAVE_MESTRA=

# Protege as rotas chamadas pelo Vercel Cron.
CRON_SECRET=
