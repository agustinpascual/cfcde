{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "cfcde-avisos-pix",
	"main": "index.ts",
	"compatibility_date": "2026-09-03",

	// A cada minuto para respeitar os atrasos configurados no painel.
	"triggers": {
		"crons": ["* * * * *"]
	},

	"vars": {
		// Sem barra no fim.
		"SITE_URL": "https://cafecomdeusepai.com"
	},

	// CRON_SECRET não fica aqui — é secret:
	//   npx wrangler secret put CRON_SECRET --name cfcde-avisos-pix
	// e o MESMO valor precisa estar no Worker do site.

	"observability": {
		"enabled": true
	}
}
